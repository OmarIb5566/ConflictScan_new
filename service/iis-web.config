<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy in front of ConflictScan (HTTPS on IIS, plain HTTP to waitress on 127.0.0.1:5000).
  Needs the IIS modules "URL Rewrite" and "Application Request Routing" (enable proxy in ARR settings).
  Put this web.config in an empty IIS site bound to https://conflictscan.<company>/ with the company certificate.
  In conflictscan.toml set:  [server] https = true, behind_proxy = true, host = "127.0.0.1"
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ConflictScan" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- match CONFLICTSCAN_MAX_UPLOAD_MB (bytes) -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
